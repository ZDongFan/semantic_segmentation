# 复制为仓库根目录 .env；已有系统环境变量优先。
LCC_DATABASE_URL='host=127.0.0.1 port=5432 user=postgres dbname=lcc_test'
# 可通过 PGPASSFILE 替代密码；请填写本机测试数据库密码。
PGPASSWORD=''
# 后端草稿、版本、审计和临时文件的统一管理目录。
LCC_STORAGE_ROOT='D:/lcc/storage'
# 仅对外查询接口使用；请生成至少 32 字符的随机值。
LCC_PUBLIC_API_KEY=''
LCC_MAX_UPLOAD_BYTES=1073741824
# 仅运行测试时需要，必须指向专用测试库。
LCC_TEST_DATABASE_URL='host=127.0.0.1 port=5432 user=postgres dbname=lcc_test'
